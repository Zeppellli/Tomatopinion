%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85cd55c6b0955304c90bc3c8ea81e738, type: 3}
  m_Name: 2bMedieval
  m_EditorClassIdentifier: Assembly-CSharp::FullSceneDialogue
  dialogueLinesInOrder:
  - line: Silence all !<2> Before thee stands this fallen wretch
    duration: 4
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 5
  - line: ' who, <1>  while being in my good graces as lieutenant in my guard, <4> 
      committed the crime of adultery,'
    duration: 8
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 5
  - line: and with my own wife !
    duration: 3
    delayBeforeNextLine: 1
    backgroundFadeAwayOnEnd: 1
    voice: 5
  - line: Bear witness,
    duration: 2
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 1
    voice: 5
  - line: as this punishment is what awaits all, <2> man or woman, <1> adult or child,
      <1> for whoever dares to go against the natural order of life and class will
      be struck down !
    duration: 8
    delayBeforeNextLine: 0.5
    backgroundFadeAwayOnEnd: 0
    voice: 5
  - line: 'I die innocent, for my heart was pure! <2> A love this strong cannot be
      quenched! '
    duration: 5
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 6
  - line: Silence!
    duration: 1
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 5
  - line: Thou hast broken the sacred laws of the Almighty.
    duration: 3
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 1
    voice: 5
  - line: Thou shalt pay for your acts, <2> and god as my witness,
    duration: 5
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 5
  - line: ' thy death shall be a warning to all about the dangers of not knowing
      thy place !'
    duration: 4
    delayBeforeNextLine: 1
    backgroundFadeAwayOnEnd: 0
    voice: 5
  - line: //END// (3b)
    duration: 3
    delayBeforeNextLine: 3
    backgroundFadeAwayOnEnd: 1
    voice: 0
