  dialogueLinesInOrder:
  - line: ' I hereby condemn thee to perish by the sacred flame for the following
      crimes'
    duration: 4
    delayBeforeNextLine: 0.5
    backgroundFadeAwayOnEnd: 0
  - line: theft against the church,
    duration: 2
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
  - line: blasphemous life,
    duration: 1.5
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
  - line: bearing false witness before the Almighty,
    duration: 2
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
  - line: ' heresy'
    duration: 1
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
  - line: ' and deviltry.'
    duration: 1
    delayBeforeNextLine: 1
    backgroundFadeAwayOnEnd: 1
  - line: 'May this glorious, purging fire cleanse thy wretched soul of all its sins. '
    duration: 6
    delayBeforeNextLine: 0.5
    backgroundFadeAwayOnEnd: 1
