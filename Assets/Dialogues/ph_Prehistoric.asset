  dialogueLinesInOrder:
  - line: Kurr thinks he look good.
    duration: 4
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 1
  - line: Dugg thinks Kurr looks bad, <3>and that Dugg looks much better because
      superior intellect and sense of style.
    duration: 6
    delayBeforeNextLine: 0.5
    backgroundFadeAwayOnEnd: 0
    voice: 2
  - line: Kurr thinks Dugg stupid and jealous of Kurr. <3> Dugg should accept hats
      are better than scarfs.
    duration: 6
    delayBeforeNextLine: 0
    backgroundFadeAwayOnEnd: 0
    voice: 1
  - line: Dugg likes scarfs, <2> and anyone who thinks not like Dugg is stupid, <4>
      just like Kurr.
    duration: 5
    delayBeforeNextLine: 0.5
    backgroundFadeAwayOnEnd: 0
    voice: 2
  - line: Kurr is going to hit Dugg if Dugg continues to have no taste.
    duration: 6
    delayBeforeNextLine: 0.5
    backgroundFadeAwayOnEnd: 1
    voice: 1
  - line: //END// (1)
